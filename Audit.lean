open Lean Elab Command in
run_cmd do
  let env ← getEnv
  let entries := (env.constants.toList.filter fun (name, _) =>
    name.toString.startsWith "_private." &&
      (env.getModuleIdxFor? name).any (fun idx =>
        (`Suzuki).isPrefixOf env.header.moduleNames[idx]!)).toArray.qsort (fun a b => Name.quickLt a.1 b.1)
  for (name, _) in entries do
    let axioms ← collectAxioms name
    let rendered := String.intercalate ", " (axioms.toList.map Name.toString)
    liftIO <| IO.println ("'" ++ name.toString ++ "' depends on axioms: [" ++ rendered ++ "]")
